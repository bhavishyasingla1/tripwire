# Firebase web app config (Project settings → Your apps). These identify the
# project; they are not secrets, but keep your own copy in .env.local.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# App Check: reCAPTCHA Enterprise site key for your hosting domain
VITE_RECAPTCHA_ENTERPRISE_KEY=
# Optional: link for the "Code" button
VITE_REPO_URL=
